function ymd(){ return today().slice(2).replace(/-/g,''); }
function keyFor(c, base){ return ymd() + '_' + base; }
function tplItems(list){ return list.map(a => ({no:a[0], count:a[1]})); }
function applyTemplate(name, opts){
  opts = opts || {};
  let c = current();
  if (!c){ addCond(); c = current(); }
  else if (!opts.silent && c.tpl !== name && (c.items.length || c.subject.ko.trim())) {
    if (!confirm('지금 편집 중인 우편 내용을 "' + TPL_NAMES[name] + '" 템플릿으로 바꿀까요?\n(날짜와 보상, 제목, 본문이 모두 템플릿 값으로 바뀝니다)')) return;
  }
  const t = today();
  c.tpl = name;
  if (name === 'regular' || name === 'emergency'){
    if (name === 'emergency' && !EMERGENCY[c.tplHours]) c.tplHours = 2;
    if (!c.tplReward) c.tplReward = 'items';
    const T = name === 'regular' ? REGULAR : EMERGENCY[c.tplHours];
    c.type = 2; c.dateMode = 'period'; c.begin_date = t; c.end_date = addDays(t, 7); c.expire = 14;
    c.mail_no = T.mail_no; c.title = T.title; c.context = T.context;
    c.useSubject = true; c.useDesc = true;
    c.subject = name === 'regular' ? Object.assign({}, REGULAR.subject) : {ko:'긴급 점검 보상', en:'Emergency Maintenance Reward'};
    c.desc = {ko:T.ko, en:T.en};
    c.from = Object.assign({}, OPS_FROM);
    c.items = c.tplReward === 'box' ? [{no:T.box, count:1}] : tplItems(T.items);
    c.onetime_key = keyFor(c, name === 'regular' ? '정기점검보상' : '긴급점검보상_' + c.tplHours + 'h');
  } else if (name === 'kimpd'){
    c.type = T_TIME; c.dateMode = 'period'; c.begin_date = t; c.end_date = addDays(t, KIMPD.days - 1); c.send_time = KIMPD.send_time; c.expire = KIMPD.expire;
    c.mail_no = KIMPD.mail_no; c.title = KIMPD.title; c.context = KIMPD.context;
    c.useSubject = true; c.useDesc = true;
    c.subject = Object.assign({}, KIMPD.subject); c.desc = {ko:KIMPD.ko, en:KIMPD.en};
    c.from = Object.assign({}, KIMPD_FROM);
    c.items = tplItems(KIMPD.items);
    c.onetime_key = '';
  } else { // custom
    c.type = 2; c.dateMode = 'period'; c.begin_date = t; c.end_date = addDays(t, 7); c.expire = 14;
    c.mail_no = 108; c.title = 1459; c.context = 1460;
    c.useSubject = true; c.useDesc = true;
    c.subject = {ko:'', en:''}; c.desc = {ko:'', en:''};
    c.from = Object.assign({}, OPS_FROM);
    c.items = []; c.onetime_key = '';
  }
  c.category = name === 'regular' ? '정기 점검 보상' : name === 'emergency' ? '긴급 점검 보상 (' + c.tplHours + '시간)' : name === 'kimpd' ? '김피디가 쏜다' : (c.category || '');
  if (c.audience === 'target') { c.type = 2; c.dateMode = 'period'; }
  fillForm(); renderAll();
  if (!opts.silent) toast('"' + TPL_NAMES[name] + '" 템플릿을 채웠습니다. 날짜와 내용을 확인하세요.');
  if (name === 'custom') { $('#fSubKo').focus(); }
}
function renderTplState(c){
  $$('#tplGrid .tpl').forEach(b => b.classList.toggle('on', !!c && b.dataset.tpl === c.tpl));
  const em = !!c && c.tpl === 'emergency';
  $('#rowEmHours').hidden = !em;
  $('#rowRewardMode').hidden = !(c && (c.tpl === 'emergency' || c.tpl === 'regular'));
  if (em){
    $$('#emHours .chip').forEach(b => b.classList.toggle('on', +b.dataset.h === c.tplHours));
    const T = EMERGENCY[c.tplHours];
    $('#emHoursHelp').textContent = T ? '점검 ' + c.tplHours + '시간 보상: ' + T.items.map(a => (ITEM_MAP[a[0]]||{}).kr + ' ' + fmt(a[1])).join(', ') + '  (Mail.xlsx 서식 ' + T.mail_no + ')' : '';
  }
  if (c && (c.tpl === 'emergency' || c.tpl === 'regular')) setSeg('segReward', c.tplReward || 'items');
}

/* ==========================================================
   유틸
   ========================================================== */
const $ = s => document.querySelector(s);
const $$ = s => Array.from(document.querySelectorAll(s));
const pad = n => String(n).padStart(2,'0');
function today(){ const d=new Date(); return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate()); }
function addDays(iso,n){ const d=new Date(iso+'T00:00:00'); d.setDate(d.getDate()+n); return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate()); }
function uid(){ return Math.random().toString(36).slice(2,9); }
function fmt(n){ return Number(n||0).toLocaleString('ko-KR'); }
function isDate(s){ return /^\d{4}-\d{2}-\d{2}$/.test(s||'') && !isNaN(new Date(s+'T00:00:00').getTime()); }
function normTime(t){
  const m = /^(\d{1,2}):(\d{1,2})$/.exec(String(t||'').trim());
  if (!m) return '';
  const h = +m[1], mi = +m[2];
  if (h > 23 || mi > 59) return '';
  return h + ':' + pad(mi);
}
function timeInputValue(t){ const n = normTime(t); if (!n) return ''; const [h,mi] = n.split(':'); return pad(h)+':'+mi; }
const KST_OFFSET = 9;
function kstToUtc(t){ const n = normTime(t); if (!n) return ''; const [h,mi] = n.split(':').map(Number); return ((h + 24 - KST_OFFSET) % 24) + ':' + pad(mi); }
function utcToKst(t){ const n = normTime(t); if (!n) return ''; const [h,mi] = n.split(':').map(Number); return ((h + KST_OFFSET) % 24) + ':' + pad(mi); }
function utcHint(t){
  const n = normTime(t); if (!n) return '';
  const h = +n.split(':')[0];
  return '→ send_time ' + kstToUtc(t) + (h < KST_OFFSET ? ' (UTC 기준 전날)' : '');
}
function dayDiff(a,b){ return Math.round((new Date(b+'T00:00:00')-new Date(a+'T00:00:00'))/86400000); }
function escHtml(s){ return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function gradeColor(g){ const k = g>10 ? g-10 : g; return GRADE_COLORS[k] || '#9AA3B2'; }
function gradeName(g){ return GRADES[g] || (g ? '등급'+g : ''); }
function strKr(no){ const s=STR[no]; return s ? s.kr : ''; }
function strEn(no){ const s=STR[no]; return s ? s.en : ''; }

// 텍스트 치환 규칙 (/n /1 /2 /3)
function escText(t, full){
  t = String(t ?? '').replace(/\r\n?/g,'\n').replace(/\n/g,'/n');
  if (full) t = t.replace(/,/g,'/1').replace(/"/g,'/2').replace(/'/g,'/3');
  return t;
}
function unescText(t){ return String(t ?? '').replace(/\/n/g,'\n').replace(/\/1/g,',').replace(/\/2/g,'"').replace(/\/3/g,"'"); }
function jsonStr(s){ return String(s).replace(/\\/g,'\\\\').replace(/"/g,'\\"'); }
function langValue(o, full){
  const ko = escText(o?.ko, full);
  let en = escText(o?.en, full);
  if (!en.trim()) en = ko;
  return {ko, en};
}
function parseLang(s){
  if (s === undefined || s === null || s === '') return null;

  // 신규 규격: {"ko":"...","en":"..."} 객체를 그대로 사용
  if (typeof s === 'object' && !Array.isArray(s)) {
    return {ko:unescText(s.ko||''), en:unescText(s.en||'')};
  }

  // 구 규격 하위 호환: JSON 객체를 문자열로 감싼 값도 읽을 수 있게 유지
  if (typeof s === 'string') {
    try {
      const o = JSON.parse(s);
      if (o && typeof o === 'object' && !Array.isArray(o)) {
        return {ko:unescText(o.ko||''), en:unescText(o.en||'')};
      }
    } catch(e){}
  }

  return {ko:unescText(String(s)), en:''};
}


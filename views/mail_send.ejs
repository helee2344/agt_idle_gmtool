/* ==========================================================
   특정 유저 발송 (대상 UID / 전달 방식 / 시트 행)
   ========================================================== */
function isTarget(c){ return !!c && c.audience === 'target'; }
function parseTargets(raw){
  const tokens = String(raw||'').split(/[\s,;]+/).filter(Boolean);
  const seen = new Set(), ids = [], bad = []; let dup = 0;
  for (const t of tokens){
    if (/^\d+$/.test(t)){ const n = +t; if (seen.has(n)) dup++; else { seen.add(n); ids.push(n); } }
    else bad.push(t);
  }
  return {ids, dup, bad};
}
function syncTargets(c){ const p = parseTargets(c.targetsRaw); c.targets = p.ids; return p; }
function deliveryLabel(c){ return c.delivery === 'direct' ? '바로 우편함에' : '기간 안에 접속하면'; }
function sendDesc(c){ // 시트 "발송" 칸
  const md = s => isDate(s) ? (+s.slice(5,7)) + '/' + (+s.slice(8,10)) : '?';
  const keep = ' · 보관 ' + (+c.expire||0) + '일';
  if (isTarget(c)) return c.delivery === 'direct' ? '대상 UID 즉시 지급 1회' + keep : md(c.begin_date) + '~' + md(c.end_date) + ' 대상 UID 접속 시 1회' + keep;
  if (c.type === T_DIRECT) return '모든 유저 즉시 발송 1회' + keep;
  if (c.type === T_TIME) return md(c.begin_date) + '~' + md(c.end_date) + ' 매일 ' + (normTime(c.send_time)||'?') + keep;
  if (c.type === 2) return md(c.begin_date) + '~' + md(c.end_date) + ' 접속 시 1회' + keep;
  if (c.dateMode === 'day') return md(c.login_date) + ' 접속 시' + keep;
  return md(c.begin_date) + '~' + md(c.end_date) + ' 접속 시 매일' + keep;
}
function rewardDesc(c){ return c.items.length ? c.items.map(it => { const item = ITEM_MAP[+it.no]; return (item ? item.kr : 'no ' + it.no) + ' ' + fmt(it.count); }).join('\n') : '없음'; }
function sheetValues(c){
  return [ today(), c.category || '', c.useSubject ? c.subject.ko : strKr(+c.title), c.from.ko, c.useDesc ? c.desc.ko : unescText(strKr(+c.context)), rewardDesc(c), sendDesc(c), isTarget(c) ? c.targets.join('\n') : '', serialize(buildCondition(c)) ];
}
function tsvCell(v){ v = String(v ?? ''); return /[\t\n"]/.test(v) ? '"' + v.replace(/"/g,'""') + '"' : v; }
function sheetRowText(c){ const vals = sheetValues(c); if ($('#fSheetSeq').checked) vals.unshift(''); return vals.map(tsvCell).join('\t'); }
function sheetRowHtml(c){ const vals = sheetValues(c); if ($('#fSheetSeq').checked) vals.unshift(''); return '<table><tr>' + vals.map(v => '<td>' + escHtml(String(v ?? '')).replace(/\n/g,'<br>') + '</td>').join('') + '</tr></table>'; }
async function copyRich(text, html){
  try { if (navigator.clipboard && window.ClipboardItem){ await navigator.clipboard.write([new ClipboardItem({'text/plain': new Blob([text],{type:'text/plain'}), 'text/html': new Blob([html],{type:'text/html'})})]); return true; } } catch(e){}
  return copyText(text);
}
function renderTargets(){
  const c = current();

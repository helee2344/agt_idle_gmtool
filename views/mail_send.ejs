function setSeg(id, v){ $$('#'+id+' button').forEach(b => b.classList.toggle('on', b.dataset.v === String(v))); }

function fillForm(){
  const c = current();
  $('#formEmpty').hidden = !!c;
  $('#form').hidden = !c;

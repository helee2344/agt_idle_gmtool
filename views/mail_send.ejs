  $('#deliveryHelp').textContent = c.delivery === 'direct' ? '서버가 대상 유저의 우편함에 바로 넣습니다. 접속 여부와 상관없고 날짜를 정하지 않습니다.' : '대상 유저가 시작일~종료일 안에 게임에 들어오면 한 통 받습니다. 기간 안에 안 들어오면 못 받으니 넉넉하게 잡으세요.';
  $('#rowDelivery').hidden = !tg; $('#rowTargets').hidden = !tg; $('#rowType').hidden = tg;
  syncTargets(c);
  $('#rowDateMode').hidden = c.type !== 1 || tg;
  $('#rowDay').hidden = !(c.type === 1 && c.dateMode === 'day') || tg;
  $('#rowPeriod').hidden = !(c.type === 2 || c.type === T_TIME || c.dateMode === 'period') || (tg && c.delivery === 'direct') || c.type === T_DIRECT;
  $('#rowKey').hidden = c.type !== 2;
  $('#rowSendTime').hidden = c.type !== T_TIME || tg;
  $('#fLogin').value = c.login_date; $('#fBegin').value = c.begin_date; $('#fEnd').value = c.end_date; $('#fKey').value = c.onetime_key;
  $('#fSendTime').value = normTime(c.send_time) || c.send_time || '';
  $('#sendTimeKst').textContent = utcHint(c.send_time);
  $$('#sendTimePresets [data-time]').forEach(b => b.classList.toggle('on', b.dataset.time === normTime(c.send_time)));
  updatePeriodHelp(c);
  $('#fTemplate').value = MAIL_MAP[+c.mail_no] ? String(c.mail_no) : '0';
  $('#fMailNo').value = c.mail_no; $('#fTitle').value = c.title; $('#fContext').value = c.context; $('#fExpire').value = c.expire;
  updateStringRefs(c);
  $('#fUseSubject').checked = c.useSubject; $('#fUseDesc').checked = c.useDesc;
  $('#subjectPair').hidden = !c.useSubject; $('#descPair').hidden = !c.useDesc;
  $('#subjectHelp').textContent = c.useSubject ? '' : '직접 쓰지 않으면 서식 번호(title)의 제목이 그대로 나갑니다. 아래 "서식 번호 (고급)"에서 확인할 수 있습니다.';
  $('#fSubKo').value = c.subject.ko; $('#fSubEn').value = c.subject.en;
  $('#fDescKo').value = c.desc.ko; $('#fDescEn').value = c.desc.en;
  $('#fFromKo').value = c.from.ko; $('#fFromEn').value = c.from.en;
  $('#fEscape').checked = state.escape;
  renderFromPresets(c);
  renderItemRows(c);
  renderIssues(c);
}
function updatePeriodHelp(c){
  const ok = isDate(c.begin_date) && isDate(c.end_date) && c.begin_date <= c.end_date;
  $('#periodDays').textContent = ok ? (dayDiff(c.begin_date,c.end_date)+1)+'일간' : '';
  $('#periodHelp').textContent = c.type === T_TIME ? '이 기간 동안 매일, 아래 시각에 모든 유저에게 보냅니다. (파일에는 begin_date / end_date로 저장)' : c.type === 2 ? '이 기간 안에 처음 게임에 들어온 날 한 통 받습니다. (파일에는 begin_date / end_date로 저장)' : '이 기간 동안 게임에 들어온 날마다 한 통씩 받습니다. (파일에는 begin_date / end_date로 저장)';
}
function updateStringRefs(c){
  const t = +c.title, x = +c.context;
  $('#titleRef').innerHTML = '<b>title '+(t||0)+'</b>' + (t ? (STR[t] ? escHtml(STR[t].kr) : '<span style="color:var(--err)">스트링 없음</span>') : '(없음)');
  $('#contextRef').innerHTML = '<b>context '+(x||0)+'</b>' + (x ? (STR[x] ? escHtml(unescText(STR[x].kr)).slice(0,120) : '<span style="color:var(--err)">스트링 없음</span>') : '(없음)');
}
function renderFromPresets(c){
  $('#fromPresets').innerHTML = FROM_PRESETS.map(p => '<button type="button" class="chip'+(p.ko===c.from.ko?' on':'')+'" data-ko="'+escHtml(p.ko)+'" data-en="'+escHtml(p.en)+'">'+escHtml(p.ko)+'</button>').join('');
}
function boxDesc(no){
  const b = BOXES[no]; if (!b) return '';
  return b.map(([r,mn,mx]) => { const it = ITEM_MAP[r]; return (it ? it.kr : 'no '+r) + ' ' + (mn===mx ? fmt(mn) : fmt(mn)+'~'+fmt(mx)); }).join(', ');
}
function renderItemRows(c){
  const tb = $('#itemRows');
  if (!c.items.length){ tb.innerHTML = '<tr class="empty-row"><td colspan="4">첨부 아이템이 없습니다. 위에서 검색하거나 바로 추가 버튼을 누르세요.</td></tr>'; return; }
  tb.innerHTML = c.items.map((it,i) => {
    const item = ITEM_MAP[+it.no];
    const name = item ? '<span class="grade" style="background:'+gradeColor(item.grade)+'"></span><span class="nm">'+escHtml(item.kr)+'<small>'+escHtml(item.en)+' · '+escHtml(gradeName(item.grade))+' · '+(TYPE_NAMES[item.type]||'')+'</small></span>' : '<span class="nm" style="color:var(--err)">알 수 없는 아이템</span>';
    const box = item && BOXES[+it.no] ? '<div class="box"><b>구성</b>'+escHtml(boxDesc(+it.no))+'</div>' : '';
    const over = item && item.max && +it.count > item.max ? '<div class="cnt-warn">최대 '+fmt(item.max)+'</div>' : '';
    return '<tr data-i="'+i+'"><td class="no">'+(+it.no||0)+'</td><td>'+name+box+'</td><td><input type="number" min="1" step="1" value="'+(+it.count||0)+'" data-i="'+i+'">'+over+'</td>'
      + '<td><button type="button" class="btn small icon ghost" data-remove="'+i+'" title="제거">✕</button></td></tr>';
  }).join('');
}
function renderIssues(c){
  const v = validate(c), box = $('#issues');
  box.className = 'issues-box ' + (v.errors.length ? 'err' : v.warns.length ? 'warn' : 'ok');
  if (!v.errors.length && !v.warns.length){ box.innerHTML = '<div><span class="tag">OK</span><span>문제 없음. 내보내도 됩니다.</span></div>'; return; }
  box.innerHTML = v.errors.map(e => '<div><span class="tag">오류</span><span>'+escHtml(e)+'</span></div>').join('') + v.warns.map(w => '<div><span class="tag">확인</span><span>'+escHtml(w)+'</span></div>').join('');
}

/* ==========================================================
   렌더: 미리보기 / JSON / 요약
   ========================================================== */
function renderPreview(){
  const c = current(), box = $('#mailPreview'), lang = state.lang;
  setSeg('segLang', lang);
  if (!c){ box.innerHTML = '<div class="mail"><div class="mail-body placeholder">우편을 선택하면 여기에 미리보기가 나옵니다.</div></div>'; $('#previewMeta').textContent=''; return; }
  const pick = o => (lang === 'en' && o.en.trim()) ? o.en : o.ko;
  const subj = c.useSubject ? pick(c.subject) : (lang==='en' ? strEn(+c.title) : strKr(+c.title));
  const body = c.useDesc ? pick(c.desc) : unescText(lang==='en' ? strEn(+c.context) : strKr(+c.context));
  const subjSrc = c.useSubject ? '' : 'title 스트링 '+(+c.title||0);
  const bodySrc = c.useDesc ? '' : 'context 스트링 '+(+c.context||0);
  $('#previewMeta').textContent = isTarget(c) ? ('특정 유저 ' + c.targets.length + '명 · ' + (c.delivery==='direct' ? '즉시 지급' : '접속 시 1회 · ' + condDate(c))) : ((c.type===T_DIRECT ? '즉시 발송 · ' : c.type===T_TIME ? '정한 시각 · ' : c.type===2 ? '접속 1회 · ' : '접속 매일 · ') + condDate(c));
  const tiles = c.items.length ? c.items.map(it => {
    const item = ITEM_MAP[+it.no];
    if (!item) return '<div class="tile unknown"><div class="tn">no '+(+it.no||0)+'</div><div class="tc">×'+fmt(it.count)+'</div></div>';
    return '<div class="tile" style="border-top-color:'+gradeColor(item.grade)+'" title="'+escHtml(item.kr+' (no '+item.no+')'+(BOXES[item.no] ? '\n'+boxDesc(item.no) : ''))+'"><div class="tn">'+escHtml(lang==='en' && item.en ? item.en : item.kr)+'</div><div class="tc">×'+fmt(it.count)+'</div></div>';
  }).join('') : '<div class="none">첨부 아이템 없음</div>';
  box.innerHTML = '<div class="mail'+(c.type===2?' t2':c.type===T_TIME?' t3':'')+'">'
    + '<div class="mail-head"><div class="mail-from">보낸 사람<b>'+escHtml(pick(c.from)||'—')+'</b></div><div class="mail-keep">보관 기간<b>'+(+c.expire||0)+'일</b></div></div>'
    + '<div class="mail-subject'+(subj?'':' placeholder')+'">'+escHtml(subj || '(제목 없음)')+'</div>'
    + (subjSrc ? '<div class="mail-src">'+subjSrc+'</div>' : '')
    + '<div class="mail-body'+(body?'':' placeholder')+'">'+escHtml(body || '(본문 없음)')+'</div>'
    + (bodySrc ? '<div class="mail-src">'+bodySrc+'</div>' : '')
    + '<div class="mail-items">'+tiles+'</div>'
    + '<div class="mail-foot"><button class="fake" type="button" tabindex="-1">'+(lang==='en'?'Claim':'받기')+'</button></div>'
    + '</div>';
}
let fileView = 'all';
function renderJson(){
  const c = current();
  $('#jsonOut').innerHTML = c ? highlight(serialize(buildCondition(c))) : '<span class="muted">선택된 우편이 없습니다.</span>';
  const tgN = state.conds.filter(isTarget).length;
  $('#segFile button[data-v=target]').textContent = '특정 유저 파일' + (tgN ? ' (' + tgN + '건)' : '');
  try {
  $('#fileOut').innerHTML = fileView === 'target' ? (tgN ? highlight(serialize(buildTargetFile())) : '<span class="muted">특정 유저 우편이 없습니다.</span>') : highlight(serialize(buildFile()));
  } catch(e){ $('#fileOut').textContent = e.message; }
}
function summaryOf(c){
  const L = [];
  L.push('[우편 발송 요청] ' + condLabel(c));
  if (c.tpl && c.tpl !== 'custom') L.push('템플릿: ' + TPL_NAMES[c.tpl] + (c.tpl === 'emergency' ? ' (점검 ' + c.tplHours + '시간)' : ''));
  if (isTarget(c)){
    L.push('받는 사람: 특정 유저 ' + c.targets.length + '명 (' + deliveryLabel(c) + ')');
    if (c.delivery !== 'direct') L.push('접속 기간: ' + condDate(c));
    if (c.onetime_key) L.push('onetime_key: ' + c.onetime_key);
  } else {
  L.push('발송 타입: ' + (TYPE_LABEL[c.type] || TYPE_LABEL[1]));
  L.push('발송일: ' + condDate(c) + (c.type===1 && c.dateMode==='day' ? ' (하루)' : ''));
  if (c.type===2) L.push('onetime_key: ' + c.onetime_key);
  }
  if (c.type===T_TIME) L.push('발송 시각: 한국 시간 ' + (normTime(c.send_time) || '(미입력)') + ' (send_time ' + (kstToUtc(c.send_time) || '(미입력)') + ') · 매일 · 접속 여부와 무관');
  const m = MAIL_MAP[+c.mail_no];
  L.push('mail_no: ' + (+c.mail_no||0) + (m ? ' ('+m.memo+')' : '') + ' / title ' + (+c.title||0) + ' / context ' + (+c.context||0) + ' / 보관 ' + (+c.expire||0) + '일');
  L.push('제목: ' + (c.useSubject ? c.subject.ko + (c.subject.en ? ' / ' + c.subject.en : '') : '스트링 no ' + (+c.title||0) + ' 사용'));
  L.push('본문: ' + (c.useDesc ? c.desc.ko.replace(/\n+/g,' ') : '스트링 no ' + (+c.context||0) + ' 사용'));
  L.push('발송인: ' + c.from.ko + (c.from.en ? ' / ' + c.from.en : ''));
  L.push('아이템:' + (c.items.length ? '' : ' 없음'));
  c.items.forEach(it => { const item = ITEM_MAP[+it.no]; L.push('  - ' + (item ? item.kr : '(알 수 없음)') + ' (no ' + (+it.no||0) + ') × ' + fmt(it.count)); });
  if (isTarget(c)) L.push('대상 UID (' + c.targets.length + '명): ' + c.targets.join(', '));
  return L.join('\n');
}
function renderSummary(){
  if (!state.conds.length){ $('#sumOut').textContent = '우편이 없습니다.'; return; }
  $('#sumOut').textContent = state.conds.map((c,i) => (state.conds.length>1 ? (i+1)+'. ' : '') + summaryOf(c)).join('\n\n');
}
function renderAll(){ renderList(); renderPreview(); renderJson(); renderSummary(); renderTargets(); updatePostButton(); save(); }
function refresh(){ // 폼 입력 후 가벼운 갱신
  const c = current(); if (c) renderIssues(c);
  renderAll();
}


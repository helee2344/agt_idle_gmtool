      + '<li><b>type 10000</b>(<code>PERIOD_TARGET_TIME_ONE_TIME_REWARD</code>)은 <code>begin_date</code>/<code>end_date</code>/<code>send_time</code>만 사용합니다. <code>login_date</code>와 <code>onetime_key</code>는 넣지 않습니다.</li>'
      + '<li><code>send_time</code>은 <b>UTC 기준</b> 시각이며 <code>1:00</code>, <code>13:00</code>처럼 앞자리 0 없이 적습니다. 이 도구에서는 한국 시간으로 입력하면 9시간을 빼서 자동으로 변환합니다. (한국 20:00 → <code>11:00</code>)</li>'
      + '<li>제목/본문/발송인은 <code>{"ko": "...", "en": "..."}</code> 형태의 문자열입니다. 직접 지정하지 않으면 <code>""</code>로 두고 title/context 스트링 no를 씁니다.</li>'
      + '<li>텍스트 치환: 줄바꿈 → <code>/n</code>, 쉼표 → <code>/1</code>, 큰따옴표 → <code>/2</code>, 작은따옴표 → <code>/3</code></li>'
      + '<li><code>subject_text</code>, <code>desc_text</code>, <code>from_text</code>는 신규 규격에 맞춰 <code>{&quot;ko&quot;:&quot;...&quot;,&quot;en&quot;:&quot;...&quot;}</code> 객체로 출력합니다. 예전 JSON 문자열 형식도 불러오기는 지원합니다.</li>'
      + '<li><code>mail_items</code>는 <code>[[아이템no, 개수], ...]</code> 이고 내부 배열은 한 줄로 씁니다.</li>'
      + '<li>영문 유저 호칭은 <b>Syncer</b> (Sinker 아님). 영문 게임명은 <b>AgathaIdle</b>로 통일.</li>'
      + '<li><b>특정 유저 발송</b>: 전체 발송 파일에 넣지 않고 targetMail.json으로 따로 냅니다. condition 모양은 type 2와 같고 <code>target_uids</code>(UID 배열)와 <code>delivery</code>(login_period / direct)가 추가됩니다. 서버 형식이 정해지면 이 파일 모양만 맞추면 됩니다.</li>'
      + '</ul>'
      + '<h3 style="margin-bottom:6px">데이터 출처</h3>'
      + '<p class="muted">Mail.xlsx '+MAILS.length+'건, Item.xlsx '+DATA.items.length+'건, ItemBox 구성 '+Object.keys(BOXES).length+'종, LocalizedString 우편 관련 '+Object.keys(STR).length+'건을 쓰고 있습니다. ' + dataSourceText() + ' 테이블이 바뀌면 위의 [테이블 갱신]에 새 엑셀을 넣으세요.</p>'
      + '</div>';
  }
}
function openRef(tab){ $('#refModal').hidden = false; renderRef(tab||'mails'); }
function closeRef(){ $('#refModal').hidden = true; }

/* ==========================================================
   초기화
   ========================================================== */
/* ==========================================================
   테이블 갱신 (엑셀 → 내장 데이터 교체, 이 브라우저에 저장)
   ========================================================== */
function dataSourceText(){
  return USER_TABLES ? '직접 갱신한 테이블(' + USER_TABLES.at + ', ' + (USER_TABLES.files||[]).join(' · ') + ')입니다. 내장 기준일은 ' + (BUILTIN.asof||'-') + '.' : '파일에 내장된 테이블(기준일 ' + (BUILTIN.asof||'-') + ')입니다.';
}
function renderDataSrc(){
  const el = $('#dataSrc');
  el.textContent = USER_TABLES ? '테이블 ' + USER_TABLES.at + ' (직접 갱신)' : '테이블 ' + (BUILTIN.asof||'-') + ' (내장)';
  el.classList.toggle('user', !!USER_TABLES);
  $('#tblStatus').textContent = '지금 쓰는 데이터: ' + dataSourceText();
  $('#btnTblReset').hidden = !USER_TABLES;
}
let tblPending = null;
function openTbl(){ tblPending = null; $('#tblResult').hidden = true; $('#btnTblApply').disabled = true; $('#tblInput').value = ''; renderDataSrc(); $('#tblModal').hidden = false; }
function closeTbl(){ $('#tblModal').hidden = true; }
async function readTableFiles(files){
  if (typeof XLSX === 'undefined'){ toast('엑셀 읽기 모듈을 찾지 못했습니다. 파일이 손상되었을 수 있습니다.', true); return; }
  const rows = [], parsed = {}, names = [];
  for (const f of files){
    let d = null, err = '';
    try { const wb = XLSX.read(await f.arrayBuffer(), {type:'array'}); d = detectTable(wb); if (!d) err = '아는 테이블이 아닙니다 (첫 줄 컬럼명을 확인)'; }
    catch(e){ err = '읽기 실패: ' + (e && e.message ? e.message : e); }
    if (d){ parsed[d.name] = d.rows; names.push(d.name + '.xlsx ' + d.rows.length + '행'); }
    rows.push('<tr><td>' + escHtml(f.name) + '</td><td class="mono">' + (d ? d.name : '—') + '</td><td class="mono">' + (d ? d.rows.length : '') + '</td><td>' + (d ? '<span class="badge ok">OK</span>' : '<span class="badge err">' + escHtml(err) + '</span>') + '</td></tr>');
  }
  $('#tblFiles').innerHTML = rows.join('');
  $('#tblResult').hidden = false;
  if (!Object.keys(parsed).length){ $('#tblSummary').innerHTML = '<h4>읽을 수 있는 테이블이 없습니다</h4><p class="muted">Item / ItemBox / Mail / LocalizedString / SnoLink 의 .xlsx 파일을 넣으세요.</p>'; $('#btnTblApply').disabled = true; tblPending = null; return; }
  const r = buildFromTables(parsed, DATA);
  // 아이템 차이 목록
  let diff = '';
  if (parsed.Item){
    const oldM = Object.fromEntries(DATA.items.map(i => [i.no, i]));
    const added = r.data.items.filter(i => !oldM[i.no]).map(i => '+ ' + i.no + ' ' + i.kr + (i.en ? ' / ' + i.en : ' (영문 이름 없음)'));
    const removed = DATA.items.filter(i => !r.data.items.some(x => x.no === i.no)).map(i => '- ' + i.no + ' ' + i.kr);
    const renamed = r.data.items.filter(i => oldM[i.no] && oldM[i.no].kr !== i.kr).map(i => '~ ' + i.no + ' ' + oldM[i.no].kr + ' → ' + i.kr);
    diff = [...added, ...removed, ...renamed].join('\n');
    const noEn = r.data.items.filter(i => !i.en && i.type <= 3).length;
    if (noEn && !parsed.LocalizedString) r.summary.push('LocalizedString.xlsx 를 같이 넣으면 비어 있는 이름·영문 이름이 채워집니다');
  }
  const used = state.conds.flatMap(c => c.items.map(it => +it.no)).filter((v,i,a) => a.indexOf(v) === i);
  const missing = used.filter(no => !r.data.items.some(i => i.no === no));
  if (missing.length) r.summary.push('작성 중인 우편에 쓰인 아이템 중 새 테이블에 없는 번호: ' + missing.join(', ') + ' (적용 후 오류로 표시됩니다)');
  $('#tblSummary').innerHTML = '<h4>적용하면 이렇게 바뀝니다</h4><ul>' + r.summary.map(s => '<li>' + escHtml(s) + '</li>').join('') + '</ul>' + (diff ? '<div class="diff">' + escHtml(diff) + '</div>' : '') + '<p class="muted" style="margin-top:8px">갱신한 데이터는 이 브라우저에만 저장됩니다. 다른 PC에서는 다시 넣어야 합니다. 작성 중인 우편은 그대로 유지됩니다.</p>';
  tblPending = { data: r.data, files: names };
  $('#btnTblApply').disabled = false;
}
function applyTables(){
  if (!tblPending) return;
  const pack = { data: tblPending.data, at: today(), files: tblPending.files };
  pack.data.asof = today();
  try { localStorage.setItem(TABLES_KEY, JSON.stringify(pack)); }
  catch(e){ toast('브라우저 저장소에 넣지 못했습니다: ' + e.message, true); return; }
  save(); location.reload();
}
function resetTables(){
  if (!confirm('직접 갱신한 테이블을 지우고 파일에 내장된 데이터(기준일 ' + (BUILTIN.asof||'-') + ')로 되돌릴까요?')) return;
  localStorage.removeItem(TABLES_KEY); save(); location.reload();
}
function bindTables(){
  $('#btnTables').addEventListener('click', openTbl);
  $('#dataSrc').addEventListener('click', openTbl);
  $('#btnTblClose').addEventListener('click', closeTbl);
  $('#btnTblCancel').addEventListener('click', closeTbl);
  $('#tblModal').addEventListener('click', e => { if (e.target === $('#tblModal')) closeTbl(); });
  $('#btnTblApply').addEventListener('click', applyTables);
  $('#btnTblReset').addEventListener('click', resetTables);
  const drop = $('#tblDrop'), input = $('#tblInput');
  drop.addEventListener('click', () => input.click());
  input.addEventListener('change', e => { if (e.target.files.length) readTableFiles(Array.from(e.target.files)); });
  drop.addEventListener('dragover', e => { e.preventDefault(); drop.classList.add('over'); });
  drop.addEventListener('dragleave', () => drop.classList.remove('over'));
  drop.addEventListener('drop', e => { e.preventDefault(); drop.classList.remove('over'); const fs = Array.from(e.dataTransfer.files).filter(f => /\.xlsx$/i.test(f.name)); if (!fs.length){ toast('.xlsx 파일만 받습니다.', true); return; } readTableFiles(fs); });
  // 어디에 떨어뜨려도 받기 (모달 밖)
  document.addEventListener('dragover', e => { if (Array.from(e.dataTransfer.types||[]).includes('Files')) e.preventDefault(); });
  document.addEventListener('drop', e => { if (!$('#tblModal').hidden || e.target.closest('.modal')) return; const fs = Array.from(e.dataTransfer.files||[]).filter(f => /\.xlsx$/i.test(f.name)); if (!fs.length) return; e.preventDefault(); openTbl(); readTableFiles(fs); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !$('#tblModal').hidden) closeTbl(); });
  renderDataSrc();
}

function init(){
  bindTables();
  // 템플릿 셀렉트
  const groups = {};
  MAILS.forEach(m => (groups[m.type] = groups[m.type] || []).push(m));
  $('#fTemplate').innerHTML = '<option value="0">[0] 템플릿 없음 (직접 입력)</option>' + Object.keys(groups).map(t =>
    '<optgroup label="'+(MAIL_TYPE_NAMES[t]||('type '+t))+'">' + groups[t].map(m => '<option value="'+m.no+'">['+m.no+'] '+escHtml(m.title_kr||m.memo)+(m.note && m.note!==m.title_kr?' — '+escHtml(m.note):'')+' ('+m.expire+'일)</option>').join('') + '</optgroup>'
  ).join('');

  bindForm();
  $('#btnAdd').addEventListener('click', () => addCond());
  $('#btnDup').addEventListener('click', () => { const c=current(); if (c) addCond(c); });
  $('#btnDel').addEventListener('click', () => { const c=current(); if (c && confirm('"'+condLabel(c)+'" 우편을 삭제할까요?')) removeCond(c.id); });
  $('#btnClear').addEventListener('click', () => { if (state.conds.length && confirm('목록 '+state.conds.length+'건을 모두 지울까요?')){ state.conds=[]; state.selected=null; fillForm(); renderAll(); } });
  $('#condList').addEventListener('click', e => { const b = e.target.closest('.cond'); if (b) select(b.dataset.id); });
  $('#btnImport').addEventListener('click', () => $('#fileInput').click());
  $('#fileInput').addEventListener('change', e => { const f = e.target.files[0]; if (!f) return; f.text().then(importText); e.target.value=''; });
  document.addEventListener('paste', e => {
    if (e.target.matches('input,textarea')) return;
    const t = (e.clipboardData||window.clipboardData).getData('text'); if (t && t.trim().startsWith('[')) { importText(t); }
  });
  $('#btnDownload').addEventListener('click', download);
  $('#btnDownload2').addEventListener('click', download);
  $('#btnRequestDownload').addEventListener('click', downloadRequest);
  $('#btnPost').addEventListener('click', postRequest);
  $('#postSenderId').addEventListener('input', updatePostButton);
  $('#postKey').addEventListener('input', updatePostButton);
  updatePostButton();
  $$('[data-copy]').forEach(b => b.addEventListener('click', async () => { const ok = await copyText($('#'+b.dataset.copy).textContent); toast(ok ? '복사했습니다.' : '복사에 실패했습니다. 직접 드래그해서 복사하세요.', !ok); }));
  $('#tabs').addEventListener('click', e => { const b = e.target.closest('button'); if (!b) return; showTab(b.dataset.tab); });
  $('#segLang').addEventListener('click', e => { const b = e.target.closest('button'); if (!b) return; state.lang = b.dataset.v; renderPreview(); save(); });
  $('#btnRef').addEventListener('click', () => openRef('mails'));
  $('#btnRefClose').addEventListener('click', closeRef);
  $('#refModal').addEventListener('click', e => { if (e.target === $('#refModal')) closeRef(); });
  $('#refTabs').addEventListener('click', e => { const b = e.target.closest('button'); if (b) renderRef(b.dataset.tab); });
  $('#refItemSearch').addEventListener('input', () => renderRef('items'));
  $('#refBody').addEventListener('click', e => {
    const m = e.target.closest('[data-use-mail]'), it = e.target.closest('[data-use-item]');
    if (m){ if (!current()) addCond(); $('#fTemplate').value = m.dataset.useMail; $('#fTemplate').dispatchEvent(new Event('change')); closeRef(); }
    if (it){ if (!current()) addCond(); addItem(+it.dataset.useItem); }
  });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !$('#refModal').hidden) closeRef(); });
  $$('.wrapToggle').forEach(cb => cb.addEventListener('change', e => { $$('.wrapToggle').forEach(x => x.checked = e.target.checked); document.body.classList.toggle('wrapjson', e.target.checked); }));
  $('#fileName').value = 'actionEventData'+today().slice(5).replace('-','')+'.json';

  const restored = load();
  if (restored) $('#draftNote').textContent = '이전 작업을 복원했습니다';
  if (!state.conds.length) state.selected = null;
  else if (!current()) state.selected = state.conds[0].id;
  fillForm(); renderAll();
}
init();
</script>
</body>
</html>

    else if (e.key === 'ArrowUp'){ e.preventDefault(); idx = Math.max(idx-1, 0); lis.forEach((l,i)=>l.classList.toggle('active',i===idx)); lis[idx]?.scrollIntoView({block:'nearest'}); }
    else if (e.key === 'Enter'){ e.preventDefault(); const li = lis[idx>=0?idx:0]; if (li){ addItem(+li.dataset.no); search.value=''; renderResults(); } }

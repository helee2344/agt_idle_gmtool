    fillForm(); renderAll();
    if (c.audience === 'target') toast('오른쪽 [대상·시트] 탭에 UID를 붙여넣으세요.');
  });
  $('#segDelivery').addEventListener('click', e => {
    const b = e.target.closest('button'); const c = current(); if (!b || !c) return;
    c.delivery = b.dataset.v; fillForm(); renderAll();
  });
  $('#btnGoTargets').addEventListener('click', () => { showTab('targets'); $('#fTargets').focus(); });
  $('#fTargets').addEventListener('input', e => { const c = current(); if (!c) return; c.targetsRaw = e.target.value; syncTargets(c); const cur = renderTargets; renderIssues(c); renderList(); renderPreview(); renderJson(); renderSummary(); renderTargets(); save(); });
  $('#btnTargetsClean').addEventListener('click', () => { const c = current(); if (!c) return; const p = parseTargets(c.targetsRaw); c.targetsRaw = p.ids.join('\n'); syncTargets(c); $('#fTargets').value = c.targetsRaw; refresh(); toast(p.ids.length + '명으로 정리했습니다.' + (p.dup ? ' 중복 ' + p.dup + '개 제거.' : '') + (p.bad.length ? ' 숫자 아닌 값 ' + p.bad.length + '개 제거.' : '')); });
  $('#btnTargetsClear').addEventListener('click', () => { const c = current(); if (!c) return; if (c.targets.length && !confirm('UID ' + c.targets.length + '명을 지울까요?')) return; c.targetsRaw = ''; syncTargets(c); $('#fTargets').value = ''; refresh(); });
  $('#btnCopyUids').addEventListener('click', async () => { const c = current(); if (!c) return; const ok = await copyText(c.targets.join('\n')); toast(ok ? 'UID ' + c.targets.length + '개를 복사했습니다.' : '복사 실패', !ok); });
  $('#fCategory').addEventListener('input', e => { const c = current(); if (!c) return; c.category = e.target.value; renderTargets(); save(); });
  $('#fSheetSeq').addEventListener('change', () => renderTargets());

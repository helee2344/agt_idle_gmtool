let state = { conds: [], selected: null, lang:'ko', escape:true, filter:'all' };

function newCond(){
  const t = today();
  return {
    id: uid(), type:1, dateMode:'day', login_date:t, begin_date:t, end_date:t, onetime_key:'', send_time:'10:00',
    tpl:null, tplHours:2, tplReward:'items',
    audience:'all', delivery:'login', targetsRaw:'', targets:[], category:'',
    mail_no:0, title:0, context:0, expire:7,
    useSubject:true, useDesc:true,
    subject:{ko:'',en:''}, desc:{ko:'',en:''}, from:{ko:'GM 하논',en:'GM Hanon'},
    items:[], extra:{}
  };
}
function current(){ return state.conds.find(c => c.id === state.selected) || null; }

function save(){
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify({conds:state.conds, selected:state.selected, escape:state.escape, lang:state.lang})); } catch(e){}
}
function load(){
  try {
    const raw = localStorage.getItem(STORAGE_KEY); if (!raw) return false;
    const o = JSON.parse(raw);
    if (Array.isArray(o.conds) && o.conds.length){ state.conds = o.conds; state.selected = o.selected; state.escape = o.escape !== false; state.lang = o.lang || 'ko'; return true; }
  } catch(e){}
  return false;
}


      const o = JSON.parse(s);
      if (o && typeof o === 'object' && !Array.isArray(o)) {
        return {ko:unescText(o.ko||''), en:unescText(o.en||'')};
      }
    } catch(e){}
  }

  return {ko:unescText(String(s)), en:''};
}


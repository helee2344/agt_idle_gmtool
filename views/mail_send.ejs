  $('#formTitle').textContent = '우편 편집';
  setSeg('segType', c.type); setSeg('segDate', c.dateMode);
  const seg = $('#segType'); seg.classList.toggle('t1', c.type===1); seg.classList.toggle('t2', c.type===2); seg.classList.toggle('t3', c.type===T_TIME);

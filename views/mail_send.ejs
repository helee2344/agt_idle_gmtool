  }
  if (parsed.LocalizedString){
    const strings = Object.assign({}, base.strings);
    for (const m of out.mails) for (const k of ['title','context']) if (m[k] && LS[m[k]]) strings[String(m[k])] = LS[m[k]];
    for (let n = 1400; n < 1500; n++) if (LS[n]) strings[String(n)] = LS[n];
    out.strings = strings; summary.push('우편 스트링 ' + Object.keys(strings).length + '건');
  }

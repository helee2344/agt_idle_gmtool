<script>
/* ==========================================================
   테이블 파서 (Item / ItemBox / Mail / LocalizedString / SnoLink → DATA 조각)
   브라우저·Node 공용. XLSX 전역(SheetJS)이 필요.
   ========================================================== */
const TABLE_DEFS = {
  Item:            { sheet:'Item',            must:['no','type','sub_type','sno_grade','count_max','name'] },
  ItemBox:         { sheet:'ItemBox',         must:['no','item_no','reward_item_no','min','max'] },
  Mail:            { sheet:'Mail',            must:['no','type','receive_date','subject','desc','reward_no'] },
  LocalizedString: { sheet:'LocalizedString', must:['no','kr','en'] },
  SnoLink:         { sheet:'SnoLink',         must:['column_name','num','name'] },
};
function sheetToRows(wb, def){
  let ws = wb.Sheets[def.sheet];
  if (!ws){ const names = wb.SheetNames.filter(n => n !== '칼럼 설명'); ws = wb.Sheets[names[names.length-1]]; }
  if (!ws) return null;
  const aoa = XLSX.utils.sheet_to_json(ws, {header:1, raw:true, defval:null, blankrows:false});
  if (!aoa.length) return null;
  const hdr = aoa[0].map(h => h == null ? '' : String(h).trim());
  for (const m of def.must) if (!hdr.includes(m)) return null;
  const rows = [];
  for (let i = 3; i < aoa.length; i++){
    const r = aoa[i]; const no = r[0];
    if (no == null) continue;
    if (typeof no === 'string'){ if (no.trim().toUpperCase() === '[EOF]') break; if (!/^\s*-?\d+(\.\d+)?\s*$/.test(no)) continue; }
    const o = {}; hdr.forEach((h,k) => { if (h) o[h] = r[k] == null ? null : r[k]; }); rows.push(o);
  }
  return rows;
}
function detectTable(wb){ // 파일 이름이 아니라 헤더로 판별
  for (const name in TABLE_DEFS){ const rows = sheetToRows(wb, TABLE_DEFS[name]); if (rows) return {name, rows}; }
  return null;
}
const ti = v => { const n = parseInt(v); return isNaN(n) ? 0 : n; };
const ts = v => (v == null || v === 0) ? '' : String(v).replace(/\r\n?/g, '\n');
function buildFromTables(parsed, base){
  // parsed: {Item:[rows], ItemBox:[...], Mail, LocalizedString, SnoLink} (각각 선택)
  // base: 현재 DATA (없는 테이블은 base 값 유지). 반환: 새 DATA + 요약
  const out = JSON.parse(JSON.stringify(base));
  const summary = [];
  const LS = {};
  if (parsed.LocalizedString){ for (const r of parsed.LocalizedString) LS[ti(r.no)] = {kr: ts(r.kr), en: ts(r.en)}; }
  const baseItemMap = {}; for (const i of base.items) baseItemMap[i.no] = i;
  const baseMailMap = {}; for (const m of base.mails) baseMailMap[m.no] = m;
  const str = (no, lang) => { const n = ti(no); if (LS[n]) return LS[n][lang] || ''; const b = base.strings[String(n)]; return b ? (b[lang === 'kr' ? 'kr' : 'en'] || '') : ''; };
  if (parsed.SnoLink){
    const g = {}; for (const r of parsed.SnoLink) if (ts(r.column_name) === 'sno_grade') g[String(ti(r.num))] = str(r.name,'kr') || ts(r['//이름']) || ('등급' + ti(r.num));
    if (Object.keys(g).length){ out.grades = g; summary.push('등급 ' + Object.keys(g).length + '단계'); }
  }
  if (parsed.Item){
    const items = []; let noEn = 0, noKr = 0;
    for (const r of parsed.Item){
      const no = ti(r.no); const prev = baseItemMap[no];
      let kr = LS[ti(r.name)] ? LS[ti(r.name)].kr : ''; let en = LS[ti(r.name)] ? LS[ti(r.name)].en : '';
      if (!kr){ kr = ts(r['//이름']) || (prev && prev.kr) || ''; }
      if (!en){ en = (prev && prev.no === no && (prev.kr === kr) && prev.en) || ''; }
      if (!kr) noKr++; if (!en && ti(r.type) <= 3) noEn++;
      items.push({ no, type: ti(r.type), sub: ti(r.sub_type), tv: ti(r.type_value), grade: ti(r.sno_grade), max: ti(r.count_max),
        kr, en, icon: ts(r.icon), note: ts(r['//이름']), exp: ti(r.exposure) });
    }
    items.sort((a,b) => a.no - b.no);
    const added = items.filter(i => !baseItemMap[i.no]).length, removed = base.items.filter(i => !items.some(x => x.no === i.no)).length;
    out.items = items;
    summary.push('아이템 ' + items.length + '건 (추가 ' + added + ', 삭제 ' + removed + (noEn ? ', 재화·입장권·상자 중 영문 이름 없음 ' + noEn : '') + ')');
  }

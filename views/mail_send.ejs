function addItem(no){
  const c = current(); if (!c) return;
  const item = ITEM_MAP[no]; if (!item){ toast('아이템 '+no+'은 없습니다.', true); return; }
  const ex = c.items.find(i => +i.no === no);
  if (ex){ toast(item.kr+'은 이미 목록에 있습니다. 수량을 조정하세요.'); }
  else c.items.push({no, count:1});
  renderItemRows(c); refresh();
  const inp = $('#itemRows input[data-i="'+(c.items.length-1)+'"]'); if (inp && !ex){ inp.focus(); inp.select(); }
}
function renderResults(){
  const q = $('#itemSearch').value.trim().toLowerCase(); const res = $('#itemResults');
  if (document.activeElement !== $('#itemSearch')) { res.hidden = true; return; }
  let list = ITEMS.filter(i => state.filter === 'all' || String(i.type) === state.filter);
  if (q) list = list.filter(i => String(i.no).startsWith(q) || i.kr.toLowerCase().includes(q) || i.en.toLowerCase().includes(q));
  list = list.slice(0, 40);
  res.hidden = false;
  res.innerHTML = list.length
    ? '<ul>'+list.map((i,k) => '<li data-no="'+i.no+'"'+(k===0?' class="active"':'')+'><span class="no">'+i.no+'</span><span><span class="grade" style="background:'+gradeColor(i.grade)+'"></span>'+escHtml(i.kr)+'<span class="en">'+escHtml(i.en)+'</span></span><span class="badge n">'+(TYPE_NAMES[i.type]||'')+(i.type>=4 && i.grade?' '+escHtml(gradeName(i.grade)):'')+'</span></li>').join('')+'</ul>'
    : '<div class="none">검색 결과가 없습니다.</div>';
}

/* ==========================================================
   목록 조작 / 가져오기 / 내보내기
   ========================================================== */
function select(id){ state.selected = id; fillForm(); renderAll(); }
function addCond(base){
  const c = base ? JSON.parse(JSON.stringify(base)) : newCond();
  c.id = uid(); if (base && c.type===2) c.onetime_key = c.onetime_key + ' (복사)';
  state.conds.push(c); select(c.id);
  if (!base) { $('#fTemplate').focus(); }
}
function removeCond(id){
  const i = state.conds.findIndex(c => c.id === id); if (i<0) return;
  state.conds.splice(i,1);
  state.selected = state.conds[Math.min(i, state.conds.length-1)]?.id || null;
  fillForm(); renderAll();
}
function fromCondition(cd, type){
  const c = newCond(); c.type = (type === 2 || type === T_TIME) ? type : 1;
  if (c.type === T_TIME){ c.dateMode='period'; c.begin_date = cd.begin_date||''; c.end_date = cd.end_date||''; c.send_time = utcToKst(cd.send_time) || (cd.send_time||''); }
  else if (c.type === 2){ c.dateMode='period'; c.onetime_key = cd.onetime_key||''; c.begin_date = cd.begin_date||''; c.end_date = cd.end_date||''; }
  else if (cd.login_date){ c.dateMode='day'; c.login_date = cd.login_date; }
  else { c.dateMode='period'; c.begin_date = cd.begin_date||''; c.end_date = cd.end_date||''; }
  c.mail_no = +cd.mail_no||0; c.title = +cd.title||0; c.context = +cd.context||0; c.expire = +cd.expire||0;
  const s = parseLang(cd.subject_text), d = parseLang(cd.desc_text), f = parseLang(cd.from_text);
  c.useSubject = !!s; c.subject = s || {ko:'',en:''};
  c.useDesc = !!d; c.desc = d || {ko:'',en:''};
  c.from = f || {ko:'',en:''};
  c.items = Array.isArray(cd.mail_items) ? cd.mail_items.map(a => ({no:+a[0]||0, count:+a[1]||0})) : [];
  if (Array.isArray(cd.target_uids)){
    c.audience = 'target'; c.type = 2; c.dateMode = 'period';
    c.delivery = cd.delivery === 'direct' ? 'direct' : 'login';
    c.onetime_key = cd.onetime_key || ''; c.begin_date = cd.begin_date || ''; c.end_date = cd.end_date || '';
    c.targetsRaw = cd.target_uids.map(String).join('\n'); syncTargets(c);
  }
  c.extra = {}; for (const k in cd) if (!KNOWN_KEYS.has(k)) c.extra[k] = cd[k];
  return c;
}
function importText(text){
  let arr; try { arr = JSON.parse(text); } catch(e){ toast('JSON을 읽지 못했습니다: '+e.message, true); return; }
  if (!Array.isArray(arr)) { toast('최상위가 배열이 아닙니다. actionEventData.json 형식이 맞는지 확인하세요.', true); return; }
  const conds = [];
  for (const b of arr){
    if (!b || !Array.isArray(b.conditions)) continue;
    for (const cd of b.conditions) {
      // type 누락 데이터도 onetime_key / send_time 유무로 안전하게 판별
      const inferredType = (+b.type === T_TIME || cd?.send_time) ? T_TIME
        : (+b.type === 2 || cd?.onetime_key || Array.isArray(cd?.target_uids)) ? 2 : 1;
      conds.push(fromCondition(cd, inferredType));
    }
  }
  if (!conds.length){ toast('불러올 condition이 없습니다.', true); return; }
  let replace = true;
  if (state.conds.length) replace = confirm('현재 목록 '+state.conds.length+'건이 있습니다.\n\n[확인] 기존 목록을 지우고 새 JSON으로 교체\n[취소] 기존 목록 뒤에 이어서 추가');
  if (replace) state.conds = conds; else state.conds.push(...conds);
  state.selected = conds[0].id; fillForm(); renderAll();
  toast(conds.length+'건을 불러왔습니다.');
}
function showTab(name){ $$('#tabs button').forEach(x => x.classList.toggle('on', x.dataset.tab === name)); $$('.tabpanel').forEach(p => p.classList.toggle('on', p.id === 'tab-' + name)); }
function downloadBlob(text, name){ const blob = new Blob([text], {type:'application/json'}); const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name; document.body.appendChild(a); a.click(); setTimeout(()=>{ URL.revokeObjectURL(a.href); a.remove(); }, 400); }
function download(){
  if (fileView !== 'target' && state.conds.some(c => c.type === T_DIRECT)){ toast('즉시 발송은 request JSON 내려받기 또는 POST 전송을 사용하세요.', true); return; }
  const errs = state.conds.map(c => validate(c).errors.length).reduce((a,b)=>a+b,0);
  if (!state.conds.length){ toast('내보낼 우편이 없습니다.', true); return; }
  if (errs && !confirm('오류가 '+errs+'건 있습니다. 그래도 내려받을까요?')) return;
  const allN = state.conds.filter(c => !isTarget(c)).length, tg = state.conds.filter(isTarget), tgUsers = tg.reduce((a,c) => a + c.targets.length, 0);
  let name = ($('#fileName').value.trim() || 'actionEventData.json'); if (!name.endsWith('.json')) name += '.json';
  if (fileView === 'target'){
    if (!tg.length){ toast('특정 유저 우편이 없습니다.', true); return; }
    downloadBlob(serialize(buildTargetFile())+'\n', name); toast(name + ' 내려받기 시작 (특정 유저 ' + tg.length + '건, ' + tgUsers + '명)'); return;
  }
  if (tg.length){
    const msg = '두 파일로 나눠서 내려받습니다.\n\n· 모든 유저 우편 ' + allN + '건 → ' + name + '\n· 특정 유저 우편 ' + tg.length + '건 (총 ' + tgUsers + '명) → ' + targetFileName() + '\n\n특정 유저 우편은 전체 발송 파일에 절대 들어가지 않습니다.';
    if (!confirm(msg)) return;
    if (allN) downloadBlob(serialize(buildFile())+'\n', name);
    setTimeout(() => downloadBlob(serialize(buildTargetFile())+'\n', targetFileName()), allN ? 600 : 0);
    toast((allN ? name + ' + ' : '') + targetFileName() + ' 내려받기 시작');
    return;
  }
  downloadBlob(serialize(buildFile())+'\n', name);
  toast(name+' 내려받기 시작');
}
async function copyText(text){
  try { await navigator.clipboard.writeText(text); return true; }
  catch(e){ const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select(); let ok=false; try{ ok = document.execCommand('copy'); }catch(_){} ta.remove(); return ok; }
}
let toastTimer;
function toast(msg, isErr){ const t = $('#toast'); t.textContent = msg; t.className = 'toast show'+(isErr?' err':''); clearTimeout(toastTimer); toastTimer = setTimeout(()=>t.classList.remove('show'), 2600); }


function buildTargetFile(){
  const tg = state.conds.filter(isTarget);
  return tg.length ? [{ type:'target', name:'TARGET_USER_ONE_TIME_REWARD', description:'특정 유저(target_uids)에게만 발송. delivery: login_period = 기간 안에 접속 시 1회, direct = 즉시 우편함 지급. 서버 형식 확정 전 임시 규격', conditions: tg.map(buildCondition) }] : [];
}
function targetFileName(){ return 'targetMail' + today().slice(5).replace('-','') + '.json'; }

function buildCondition(c){
  const o = {};
  if (isTarget(c)){
    o.onetime_key = c.onetime_key || '';
    o.delivery = c.delivery === 'direct' ? 'direct' : 'login_period';
    o.begin_date = c.delivery === 'direct' ? '' : (c.begin_date || ''); o.end_date = c.delivery === 'direct' ? '' : (c.end_date || '');
  } else
  if (c.type === T_DIRECT){ /* 즉시 발송은 날짜, 시각, 접속 조건을 보내지 않는다. */ }
  else if (c.type === T_TIME){ o.begin_date = c.begin_date || ''; o.end_date = c.end_date || ''; o.send_time = kstToUtc(c.send_time) || ''; }
  else if (c.type === 2){ o.onetime_key = c.onetime_key || ''; o.begin_date = c.begin_date || ''; o.end_date = c.end_date || ''; }
  else if (c.dateMode === 'day'){ o.login_date = c.login_date || ''; }
  else { o.login_date = ''; o.begin_date = c.begin_date || ''; o.end_date = c.end_date || ''; }
  o.mail_no = +c.mail_no || 0; o.title = +c.title || 0; o.context = +c.context || 0; o.expire = +c.expire || 0;
  // 신규 actionEventData 규격: 다국어 텍스트는 JSON 문자열이 아니라 객체로 출력
  o.subject_text = c.useSubject ? langValue(c.subject, state.escape) : '';
  o.desc_text = c.useDesc ? langValue(c.desc, state.escape) : '';
  o.from_text = langValue(c.from, state.escape);
  o.mail_items = c.items.map(it => [+it.no || 0, +it.count || 0]);
  if (isTarget(c)) o.target_uids = c.targets.slice();
  for (const k in (c.extra||{})) if (!(k in o)) o[k] = c.extra[k];
  if (c.type === T_DIRECT) for (const k of ['login_date','begin_date','end_date','send_time','onetime_key']) delete o[k];
  return o;
}
function serialize(obj){
  return JSON.stringify(obj, null, 2)
    .replace(/\[\s+(-?\d+),\s+(-?\d+)\s+\]/g, '[$1,$2]')
    .replace(/"target_uids": \[([^\]]*)\]/g, (m, inner) => '"target_uids": [' + inner.replace(/\s+/g,'').replace(/,/g,', ') + ']');
}
function buildFile(){
  if (state.conds.some(c => c.type === T_DIRECT)) throw new Error('즉시 발송은 request JSON 내려받기 또는 POST 전송을 사용하세요.');
  // 안전장치: 특정 유저 우편은 전체 발송 파일에 절대 포함하지 않는다.
  const all = state.conds.filter(c => !isTarget(c));
  const t1 = all.filter(c => c.type === 1), t2 = all.filter(c => c.type === 2), t3 = all.filter(c => c.type === T_TIME);
  const arr = [];
  // 실제 우편이 존재하는 타입 블록만 출력한다.
  // type 1 우편이 0건이면 빈 type 1 블록을 만들지 않는다.
  if (t1.length) arr.push({ type:1, name:'DAILY_LOGIN_REWARD', conditions:t1.map(buildCondition) });
  if (t2.length) arr.push({ type:2, name:'LOGIN_PERIOD_ONE_TIME_REWARD', description:'지정한 기한 안에 로그인시 한번만 지급', conditions:t2.map(buildCondition) });
  if (t3.length) arr.push({ type:T_TIME, name:'PERIOD_TARGET_TIME_ONE_TIME_REWARD', description:'지정한 기한에 지정한 시간에 매일 발송, 이건 별도 게임 서버에 통합이 아닌 시스템으로 작동함', conditions:t3.map(buildCondition) });
  return arr;
}
const REQUEST_TEMPLATE = {
  command_type: 'SEND_MAIL',
  ADMIN_EXECUTE_FIRST_KEY: '<%=ADMIN_EXECUTE_FIRST_KEY%>',
  ADMIN_EXECUTE_SECOND_KEY: '<%=ADMIN_EXECUTE_SECOND_KEY%>',
  ADMIN_EXECUTE_THIRD_KEY: '<%=ADMIN_EXECUTE_THIRD_KEY%>',
};

function requestMailInfo(c){
  const x = buildCondition(c);
  const keys = ['onetime_key','begin_date','end_date','mail_no','title','context','expire','subject_text','desc_text','from_text','mail_items'];
  const out = {};
  for (const k of keys) if (x[k] !== undefined && x[k] !== '') out[k] = x[k];
  return out;
}
function buildRequestPayload(){
  if (!state.conds.length) throw new Error('발송할 우편이 없습니다.');
  const targetConds = state.conds.filter(isTarget), allConds = state.conds.filter(c => !isTarget(c));
  if (targetConds.length && allConds.length) throw new Error('request 형식은 target_info가 하나이므로 모든 유저/특정 유저 우편을 한 요청에 섞을 수 없습니다. 한 종류만 남기거나 각각 따로 전송하세요.');
  let targetInfo;
  let conds;
  if (targetConds.length){
    const ids = [...new Set(targetConds.flatMap(c => { syncTargets(c); return c.targets; }))];
    if (!ids.length) throw new Error('특정 유저 UID가 없습니다.');
    targetInfo = {comment:'ALL_USERS / TARGET_USER_IDXS ', target_type:'TARGET_USER_IDXS', user_idxs:ids, exclusion_user_idxs:[]};
    conds = targetConds;
  } else {
    targetInfo = {comment:'ALL_USERS / TARGET_USER_IDXS ', target_type:'ALL_USERS', user_idxs:[], exclusion_user_idxs:[]};
    conds = allConds;
  }
  return {...REQUEST_TEMPLATE, SEND_MAIL:{target_info:targetInfo, mail_infos:conds.map(requestMailInfo)}};
}
function requestFileName(){ return 'request_' + today().replace(/-/g,'') + '.json'; }
function downloadRequest(){
  try { downloadBlob(JSON.stringify(buildRequestPayload(), null, 2)+'\n', requestFileName()); toast(requestFileName()+' 내려받기 시작'); }
  catch(e){ toast(e.message, true); }
}
let postInFlight = false;
let postEndpoint = '';
async function loadPostConfig(){
  postEndpoint = '';
  updatePostButton();
  try {
    if (location.protocol === 'file:') throw new Error('npm start 실행 후 http://127.0.0.1:3000 에서 열어주세요.');
    const res = await fetch( '<%=POST_URL_SEND_MAIL %>', {cache:'no-store'});
    const config = await res.json();
    if (!res.ok) throw new Error(config.error || 'POST URL 설정을 읽지 못했습니다.');
    const url = new URL(config.postUrl);
    if (!['http:', 'https:'].includes(url.protocol)) throw new Error('POST URL 설정이 올바르지 않습니다.');
    postEndpoint = url.href;
    $('#postEndpoint').textContent = postEndpoint;
  } catch(e){
    $('#postEndpoint').textContent = e.message;
  }
  updatePostButton();
}
function canPostImmediately(){
  return state.conds.length > 0 && state.conds.every(c => isTarget(c) ? c.delivery === 'direct' : c.type === T_DIRECT);
}
function updatePostButton(){
  const immediate = canPostImmediately();
  $('#btnPost').disabled = postInFlight || !postEndpoint || !immediate || !$('#postSenderId').value.trim() || !$('#postKey').value.trim();
  $('#btnPost').title = immediate ? '' : '발송 목록의 모든 우편이 즉시 발송일 때만 HTTP POST 전송할 수 있습니다.';
}
async function postRequest(){
  if (postInFlight) return;
  if (!canPostImmediately()){ toast('HTTP POST 전송은 발송 목록의 모든 우편이 즉시 발송일 때만 가능합니다.', true); return; }
  const senderId = $('#postSenderId').value.trim();
  const key = $('#postKey').value;
  if (!senderId){ toast('SENDER ID를 입력하세요.', true); $('#postSenderId').focus(); return; }
  if (!key.trim()){ toast('KEY를 입력하세요.', true); $('#postKey').focus(); return; }
  const url = postEndpoint;
  if (!url){ toast('.env의 POST_URL 설정을 확인하고 페이지를 새로고침하세요.', true); return; }
  let payload; try { payload = {...buildRequestPayload(), sender_id: senderId, key}; } catch(e){ toast(e.message, true); return; }
  if (!confirm('현재 우편 요청을 다음 주소로 POST 전송할까요?\n\n'+url)) return;
  postInFlight = true;
  const btn = $('#btnPost'); updatePostButton(); const old = btn.textContent; btn.textContent = '전송 중...';
  try {
    alert(JSON.stringify(payload))
    const res = await fetch(url, {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload)});
    const body = await res.text();
    if (!res.ok) throw new Error('HTTP '+res.status+' '+res.statusText+(body ? ' · '+body.slice(0,180) : ''));
    toast('POST 전송 성공 (HTTP '+res.status+')');
  } catch(e){ toast('POST 전송 실패: '+e.message, true); }
  finally { postInFlight = false; btn.textContent = old; updatePostButton(); }
}

function highlight(json){
  return escHtml(json).replace(/("(?:[^"\\]|\\.)*")(\s*:)?|(-?\b\d+(?:\.\d+)?\b)/g, (m,str,colon,num) => {
    if (str) return colon ? '<span class="k">'+str+'</span>'+colon : '<span class="s">'+str+'</span>';
    if (num) return '<span class="n">'+num+'</span>';
    return m;
  });
}

/* ==========================================================
   검증
   ========================================================== */
function validate(c){
  const E = [], W = [];
  const t = today();
  if (isTarget(c)){
    const p = parseTargets(c.targetsRaw);
    if (!p.ids.length) E.push('특정 유저 발송인데 대상 UID가 없습니다. 오른쪽 [대상·시트] 탭에 UID를 넣으세요.');
    if (p.bad.length) W.push('UID 목록에 숫자가 아닌 값 ' + p.bad.length + '개가 있어 무시됩니다.');
    if (c.delivery !== 'direct'){
      if (!isDate(c.begin_date) || !isDate(c.end_date)) E.push('시작일 / 종료일을 입력하세요. (기간 안에 접속해야 받는 방식)');
      else if (c.begin_date > c.end_date) E.push('종료일이 시작일보다 앞입니다.');
      else if (c.end_date < t) W.push('종료일이 이미 지났습니다.');
      else if (dayDiff(c.begin_date, c.end_date) < 3) W.push('접속 기간이 ' + (dayDiff(c.begin_date, c.end_date)+1) + '일뿐입니다. 이 기간에 접속하지 않은 대상자는 받지 못합니다.');
    }
    if (!c.onetime_key.trim()) W.push('우편 이름표가 비어 있습니다. 특정 유저 발송이라도 이름표가 있으면 이력 관리에 좋습니다.');
    else { const dup = state.conds.filter(x => x.id !== c.id && x.onetime_key.trim() === c.onetime_key.trim()); if (dup.length) E.push('우편 이름표 "'+c.onetime_key+'"가 다른 우편과 중복됩니다.'); }
  } else if (c.type === T_DIRECT){
    // 즉시 발송에는 날짜 및 접속 조건이 필요하지 않다.
  } else if (c.type === T_TIME){
    if (!isDate(c.begin_date) || !isDate(c.end_date)) E.push('begin_date / end_date를 YYYY-MM-DD로 입력하세요.');
    else if (c.begin_date > c.end_date) E.push('end_date가 begin_date보다 앞입니다.');
    else if (c.end_date < t) W.push('종료일이 이미 지났습니다.');
    if (!normTime(c.send_time)) E.push('send_time을 0:00 ~ 23:59 사이의 시각으로 입력하세요. type 10000은 반드시 필요합니다.');
    else {
      const dup = state.conds.filter(x => x.type === T_TIME && x.id !== c.id
        && normTime(x.send_time) === normTime(c.send_time)
        && x.begin_date === c.begin_date && x.end_date === c.end_date);
      if (dup.length) W.push('같은 기간·같은 시각(' + normTime(c.send_time) + ' KST)으로 발송되는 우편이 또 있습니다.');
      if (+normTime(c.send_time).split(':')[0] < KST_OFFSET) W.push('한국 시간 9:00 이전이라 send_time이 ' + kstToUtc(c.send_time) + ' (UTC 기준 전날)이 됩니다. 발송 기간 날짜를 확인하세요.');
    }
  } else if (c.type === 2){
    if (!c.onetime_key.trim()) E.push('onetime_key가 비어 있습니다. type 2는 반드시 필요합니다.');
    else {
      const dup = state.conds.filter(x => x.type === 2 && x.id !== c.id && x.onetime_key.trim() === c.onetime_key.trim());
      if (dup.length) E.push('onetime_key "'+c.onetime_key+'"가 다른 type 2 우편과 중복됩니다.');
    }
    if (!isDate(c.begin_date) || !isDate(c.end_date)) E.push('begin_date / end_date를 YYYY-MM-DD로 입력하세요.');
    else if (c.begin_date > c.end_date) E.push('end_date가 begin_date보다 앞입니다.');
    else if (c.end_date < t) W.push('종료일이 이미 지났습니다.');
  } else if (c.dateMode === 'day'){
    if (!isDate(c.login_date)) E.push('login_date를 YYYY-MM-DD로 입력하세요.');
    else if (c.login_date < t) W.push('발송일이 이미 지났습니다.');
  } else {
    if (!isDate(c.begin_date) || !isDate(c.end_date)) E.push('begin_date / end_date를 YYYY-MM-DD로 입력하세요.');
    else if (c.begin_date > c.end_date) E.push('end_date가 begin_date보다 앞입니다.');
    else if (c.end_date < t) W.push('종료일이 이미 지났습니다.');
  }
  if (!(+c.expire >= 1)) E.push('보관 기간(expire)은 1일 이상이어야 합니다.');
  const mailNo = +c.mail_no || 0;
  if (mailNo && !MAIL_MAP[mailNo]) W.push('mail_no '+mailNo+'은 Mail.xlsx에 없습니다.');
  if (+c.title && !STR[+c.title]) W.push('title 스트링 no '+c.title+'을 LocalizedString에서 찾지 못했습니다.');
  if (+c.context && !STR[+c.context]) W.push('context 스트링 no '+c.context+'을 LocalizedString에서 찾지 못했습니다.');
  if (c.useSubject){ if (!c.subject.ko.trim()) E.push('제목(한국어)이 비어 있습니다.'); else if (!c.subject.en.trim()) W.push('제목 영문이 비어 있어 한국어를 그대로 넣습니다.'); }
  else if (!(+c.title)) E.push('제목을 직접 입력하지 않으면 title 스트링 no가 필요합니다.');
  if (c.useDesc){ if (!c.desc.ko.trim()) E.push('본문(한국어)이 비어 있습니다.'); else if (!c.desc.en.trim()) W.push('본문 영문이 비어 있어 한국어를 그대로 넣습니다.'); }
  else if (!(+c.context)) E.push('본문을 직접 입력하지 않으면 context 스트링 no가 필요합니다.');
  if (!c.from.ko.trim()) E.push('발송인이 비어 있습니다.');
  const enAll = [c.useSubject?c.subject.en:'', c.useDesc?c.desc.en:'', c.from.en].join(' ');
  if (/sinker/i.test(enAll)) W.push('영문에 "Sinker"가 있습니다. 표기 규칙은 "Syncer"입니다.');
  if (!c.items.length) W.push('첨부 아이템이 없습니다. (안내용 우편이면 그대로 두세요)');
  const seen = new Set();
  c.items.forEach((it,i) => {
    const no = +it.no, cnt = +it.count, item = ITEM_MAP[no];
    if (!item) E.push((i+1)+'번째 아이템 no '+no+'은 Item.xlsx에 없습니다.');
    if (!(cnt >= 1)) E.push((item ? item.kr : 'no '+no)+' 수량이 1 이상이어야 합니다.');
    else if (item && item.max && cnt > item.max) W.push(item.kr+' 수량 '+fmt(cnt)+'이 최대 보유 '+fmt(item.max)+'을 넘습니다.');
    if (seen.has(no)) W.push((item ? item.kr : 'no '+no)+'이(가) 두 번 이상 들어 있습니다.');
    seen.add(no);
  });
  return {errors:E, warns:W};
}

/* ==========================================================
   렌더: 목록
   ========================================================== */
function condLabel(c){
  if (c.useSubject && c.subject.ko.trim()) return c.subject.ko.trim();
  if (+c.title && STR[+c.title]) return STR[+c.title].kr;
  if (+c.mail_no && MAIL_MAP[+c.mail_no]) return MAIL_MAP[+c.mail_no].memo || ('mail_no '+c.mail_no);
  return '(제목 없음)';
}
function condDate(c){
  if (c.type === T_DIRECT) return 'POST 요청 시 즉시';
  if (c.type === T_TIME) return (c.begin_date||'?')+' ~ '+(c.end_date||'?')+' · '+(normTime(c.send_time) ? normTime(c.send_time)+' KST' : '시각 미입력');
  if (c.type === 2 || c.dateMode === 'period') return (c.begin_date||'?')+' ~ '+(c.end_date||'?');
  return c.login_date || '?';
}
function renderList(){
  const box = $('#condList');
  $('#condCount').textContent = state.conds.length ? state.conds.length+'건' : '';
  if (!state.conds.length){
    box.innerHTML = '<div class="empty"><strong>아직 우편이 없습니다</strong>+ 새 우편으로 시작하거나<br>기존 JSON을 불러오세요.</div>';
    return;
  }
  box.innerHTML = state.conds.map(c => {
    const v = validate(c);
    const issues = v.errors.length ? '<span class="badge err">오류 '+v.errors.length+'</span>' : (v.warns.length ? '<span class="badge warn">확인 '+v.warns.length+'</span>' : '<span class="badge ok">OK</span>');
    return '<button type="button" class="cond'+(c.id===state.selected?' selected':'')+'" data-id="'+c.id+'">'
      + '<div class="l1">' + (isTarget(c) ? '<span class="badge tg">대상 '+c.targets.length+'명</span><span class="badge dl">'+(c.delivery==='direct'?'즉시':'접속 1회')+'</span>' : '<span class="badge '+(TYPE_CLASS[c.type]||'t1')+'">'+(TYPE_SHORT[c.type]||'매일')+'</span>') + '<span class="date">'+escHtml(isTarget(c) && c.delivery==='direct' ? '즉시 지급' : condDate(c))+'</span></div>'
      + '<div class="subj">'+escHtml(condLabel(c))+'</div>'
      + '<div class="l3"><span>아이템 '+c.items.length+'종 · mail_no '+(+c.mail_no||0)+'</span><span class="issues">'+issues+'</span></div>'
      + '</button>';
  }).join('');
}

